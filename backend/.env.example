# SmartBloodBank Backend Environment Variables

# Database
DATABASE_URL=sqlite:///smartblood.db
# For production PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/smartblood

# JSON Web Token (change to secure random string in production)
JWT_SECRET=your-secure-secret-key-here-min-32-chars

# Email Configuration (Gmail example, use your own SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@smartbloodbank.com

# Frontend URL (for verification links)
FRONTEND_URL=http://localhost:5173

# Flask
FLASK_ENV=development
FLASK_APP=app.py
